# Synthetic local demo. Copy to .env.local; never commit real credentials.
PANDA_AI_MODE=demo
PANDA_TTS_MODE=browser

# Optional camera-to-text wording, called only by the Rehab server.
REHAB_GEMINI_MODE=off
REHAB_GEMINI_API_KEY=
REHAB_GEMINI_MODEL=
REHAB_GEMINI_TIMEOUT_MS=2000

# Set PANDA_DEV_ORIGIN to the hostname of an access-controlled HTTPS demo tunnel.
# PANDA_DEV_ORIGIN=your-demo-host.example
# PANDA_DATA_DIR=an-absolute-dedicated-demo-data-folder

# Synthetic demo only. Solo commands default to fixture; npm run dev connects peers.
# Leave unset to let the runner select the correct integration mode.
# PANDA_INTEGRATION=connected
PANDA_AI_MODE=demo
PANDA_TTS_MODE=browser
# Panda and connected Rehab use gemini-3.5-flash-lite with separate server-side API keys.
PANDA_GEMINI_API_KEY=
# Optional separate server-only key for Rehab feedback wording. Camera measurements/calibration are local.
REHAB_GEMINI_API_KEY=
PANDA_OPENAI_API_KEY=
PANDA_OPENAI_MODEL=
PANDA_ELEVENLABS_API_KEY=
PANDA_ELEVENLABS_VOICE_ID=
PANDA_ELEVENLABS_MODEL_ID=
PANDA_STT_MODEL=scribe_v2
# Absolute persistent directory recommended for deployments. Never commit it.
# PANDA_DATA_DIR=/absolute/path/to/panda-data
# PANDA_VOICE_DATABASE=/absolute/path/to/panda-data/voice.sqlite
PANDA_CARE_ORIGIN=http://127.0.0.1:3001
PANDA_REHAB_ORIGIN=http://127.0.0.1:3002

# Production uses Supabase Auth + PostgreSQL. Local demos remain the default.
# Never enable production with the demo identities or fixture peers.
PANDA_RUNTIME=demo
# PANDA_PUBLIC_ORIGIN=https://your-service.onrender.com
# PANDA_SUPABASE_URL=https://your-project.supabase.co
# PANDA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# PANDA_DATABASE_URL=postgresql://panda_server.PROJECT:SECRET@SESSION_POOLER:5432/postgres
# PANDA_DATABASE_CA="-----BEGIN CERTIFICATE-----..."
# Administrative tooling only; NEVER set this on the web service:
# PANDA_MIGRATION_DATABASE_URL=postgresql://admin:SECRET@HOST:5432/postgres

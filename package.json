{
  "name": "panda-care",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/run.mjs dev all",
    "dev:ranveer": "node scripts/run.mjs dev panda",
    "dev:asmita": "node scripts/run.mjs dev care",
    "dev:yuvraj": "node scripts/run.mjs dev rehab",
    "build": "node scripts/run.mjs build all",
    "start": "node scripts/run.mjs start all",
    "typecheck": "tsc -p apps/panda && tsc -p apps/care && tsc -p apps/rehab && tsc -p tsconfig.tests.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:integration": "node scripts/integration.mjs",
    "cv:assets": "node scripts/cv-assets.mjs",
    "test:cv": "node --import tsx --test tests/rehab-cv*.test.ts",
    "test:browser": "playwright test",
    "test:cv:http": "node scripts/cv-http-smoke.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
